{
  "name": "hireguard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'vite --open'",
    "build": "tsc -b && vite build",
    "lint": "tsc && eslint .  --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "infra:diff:dev": "sst diff --stage dev",
    "infra:deploy:dev": "sst deploy --stage dev",
    "infra:deploy:staging": "sst deploy --stage staging"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/openai": "^3.0.0",
    "@aws-sdk/client-sesv2": "^3.1035.0",
    "@convex-dev/agent": "^0.6.1",
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-router": "^1.168.23",
    "@tanstack/react-table": "^8.21.3",
    "aws-cdk-lib": "^2.250.0",
    "clsx": "^2.1.1",
    "convex": "^1.35.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1",
    "simple-statistics": "^7.8.9",
    "sst": "^4.10.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^1.2.2",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "prettier": "^3.8.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^7.3.2"
  }
