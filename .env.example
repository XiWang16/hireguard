# Convex local/dev values
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# AWS integration endpoints (required for full pipeline behavior)
PDF_EXTRACT_URL=
STATS_COMPUTE_URL=
SES_ALERT_URL=

# Alerting configuration
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# LLM provider selection
# Global fallback: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic
# Per-agent overrides (optional) — takes precedence over LLM_PROVIDER
# RESUME_PARSER_PROVIDER=openai
# SKILL_MATCHER_PROVIDER=openai
# RANKER_PROVIDER=openai
# FAIRNESS_AUDITOR_PROVIDER=openai

# API keys — only the key for the active provider(s) is required
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
